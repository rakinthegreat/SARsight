#!/bin/sh
# Block any push to the PUBLIC origin that contains private-build commits (incl. via merges).
remote="$1"; url="$2"
case "$url" in *rakinthegreat/SARsight-private*) exit 0;; esac
root=$(git config sarsight.privateRoot)
[ -z "$root" ] && exit 0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$local_ref" = "refs/heads/private-build" ] || git merge-base --is-ancestor "$root" "$local_sha" 2>/dev/null; then
    echo "BLOCKED: '$local_ref' contains private SARsight work; it may only be pushed to SARsight-private." >&2
    exit 1
  fi
done
exit 0
